  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health - list books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('response is an array', function () {",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create book",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now();",
              "pm.collectionVariables.set('bookTitle', `Newman Book ${suffix}`);",
              "pm.collectionVariables.set('updatedTitle', `Updated Newman Book ${suffix}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('created book has expected fields', function () {",
              "  pm.expect(json).to.have.property('id').that.is.a('string').and.is.not.empty;",
              "  pm.expect(json.title).to.eql(pm.collectionVariables.get('bookTitle'));",
              "  pm.expect(json.author).to.eql('Robert C. Martin');",
              "  pm.expect(json.price).to.eql(29.99);",
              "  pm.expect(json.publishedYear).to.eql(2008);",
              "  pm.expect(json).to.have.property('createdAt');",
              "  pm.expect(json).to.have.property('updatedAt');",
              "});",
              "",
              "pm.collectionVariables.set('bookId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{bookTitle}}\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": 29.99,\n  \"publishedYear\": 2008\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        }
      }
    },
